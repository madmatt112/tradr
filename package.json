{
  "name": "tradr",
  "private": true,
  "license": "Apache-2.0",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "dev": "pnpm -r --parallel dev",
    "build": "pnpm -r build",
    "lint": "eslint .",
    "eslint:deps": "depcruise --config .dependency-cruiser.cjs apps packages",
    "check:migrations": "bash scripts/check-post-migration-consistency.sh",
    "drill:backup-restore": "bash scripts/backup-restore-drill.sh",
    "seed": "pnpm --filter @tradr/api seed",
    "check-types": "pnpm -r check-types",
    "test": "vitest",
    "prepare": "husky"
  },
  "lint-staged": {
    "*.{ts,tsx}": "eslint --fix",
    "*.{ts,tsx,json,md,css}": "prettier --write"
  },
  "devDependencies": {
    "dependency-cruiser": "^17.3.10",
    "eslint": "^9.22.0",
    "eslint-plugin-import-x": "^4.6.0",
    "husky": "^9.1.7",
    "lint-staged": "^15.4.3",
    "prettier": "^3.5.3",
    "tsx": "^4",
    "typescript": "^5.8.2",
    "typescript-eslint": "^8.26.0",
    "vitest": "^3.0.9"
  }
}
